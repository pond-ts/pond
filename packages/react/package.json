{
  "name": "@pond-ts/react",
  "version": "0.67.0",
  "description": "React hooks for pond-ts: subscribe to LiveSeries and derived views with throttled snapshots",
  "keywords": [
    "time-series",
    "timeseries",
    "typescript",
    "streaming",
    "analytics",
    "react",
    "hooks",
    "live",
    "realtime",
    "dashboard",
    "pond-ts"
  ],
  "homepage": "https://pond-ts.org/docs/react/",
  "bugs": {
    "url": "https://github.com/pond-ts/pond/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pond-ts/pond.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs-fallback.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "API.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "cp ../../README.md ./README.md && cp ../../LICENSE ./LICENSE && cp ../../CHANGELOG.md ./CHANGELOG.md && cp ../../API.md ./API.md && cp ../../docs/agents/USING_POND.md ./AGENTS.md && npm run build && cp cjs-fallback.cjs dist/cjs-fallback.cjs && find dist -name '*.map' -delete",
    "test": "npm run test:type && npm run test:runtime",
    "test:type": "tsc -p tsconfig.types.json",
    "test:runtime": "vitest run"
  },
  "peerDependencies": {
    "pond-ts": "^0.67.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
