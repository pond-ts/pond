{
  "name": "@pond-ts/rs",
  "version": "0.75.0",
  "description": "pond-rs (Rust) compiled to WebAssembly, with pond-ts's method names",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "imports": {
    "#wasm": {
      "node": "./wasm.node.js",
      "default": "./wasm.browser.js"
    }
  },
  "files": [
    "index.js",
    "wasm.node.js",
    "wasm.browser.js",
    "pkg/pond_wasm.js",
    "pkg/pond_wasm_bg.wasm",
    "LICENSE",
    "CHANGELOG.md",
    "API.md"
  ],
  "scripts": {
    "build": "./build.sh",
    "prepack": "cp ../../LICENSE ./LICENSE && cp ../../CHANGELOG.md ./CHANGELOG.md && cp ../../API.md ./API.md && test -f pkg/pond_wasm_bg.wasm",
    "test": "node test/parity.mjs && node test/inputs.mjs && node test/expr.mjs && node test/studies.mjs && node test/live.mjs && node test/tojson.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "homepage": "https://pond-ts.org/docs/pond-rs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pond-ts/pond.git",
    "directory": "packages/rs"
  },
  "keywords": [
    "time-series",
    "timeseries",
    "webassembly",
    "wasm",
    "rust",
    "analytics",
    "rolling-window",
    "aggregate",
    "streaming",
    "finance",
    "technical-indicators",
    "pond-ts",
    "pond-rs"
  ]
}
