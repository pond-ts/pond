{
  "name": "@pond-ts/financial",
  "version": "0.68.0",
  "private": false,
  "description": "Financial-market domain library on pond-ts: trading calendars, session-aligned OHLCV bars, and 60+ oracle-verified technical studies (SMA, EMA, RSI, MACD, Bollinger, ATR, VWAP, …)",
  "keywords": [
    "time-series",
    "timeseries",
    "typescript",
    "streaming",
    "analytics",
    "finance",
    "trading",
    "technical-analysis",
    "technical-indicators",
    "ohlc",
    "ohlcv",
    "candlestick",
    "sma",
    "ema",
    "rsi",
    "macd",
    "bollinger-bands",
    "atr",
    "vwap",
    "trading-calendar",
    "market-hours",
    "quant",
    "pond-ts"
  ],
  "homepage": "https://pond-ts.org/docs/financial/",
  "bugs": {
    "url": "https://github.com/pond-ts/pond/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pond-ts/pond.git",
    "directory": "packages/financial"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs-fallback.cjs"
    },
    "./fluent": {
      "types": "./dist/fluent.d.ts",
      "import": "./dist/fluent.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./parallel": {
      "types": "./dist/parallel/index.d.ts",
      "import": "./dist/parallel/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "API.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepack": "cp ../../LICENSE ./LICENSE && cp ../../CHANGELOG.md ./CHANGELOG.md && cp ../../API.md ./API.md && cp ../../docs/agents/USING_POND.md ./AGENTS.md && npm run build && cp cjs-fallback.cjs dist/cjs-fallback.cjs && find dist -name '*.map' -delete",
    "test": "npm run test:type && npm run test:runtime",
    "test:type": "tsc -p tsconfig.types.json",
    "test:runtime": "vitest run",
    "verify": "npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "peerDependencies": {
    "pond-ts": "^0.68.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
