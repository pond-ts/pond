{
  "name": "pond-ts",
  "version": "0.67.0",
  "description": "Typed time series for TypeScript: schema-driven TimeSeries + streaming LiveSeries with aggregate, rolling, align, fill, partitionBy and typed columns",
  "keywords": [
    "time-series",
    "timeseries",
    "typescript",
    "streaming",
    "analytics",
    "rolling-window",
    "aggregate",
    "resample",
    "downsample",
    "partition",
    "live",
    "realtime",
    "metrics",
    "telemetry",
    "ohlc",
    "immutable",
    "columnar",
    "arrow",
    "pondjs"
  ],
  "homepage": "https://pond-ts.org/docs/pond-ts/",
  "bugs": {
    "url": "https://github.com/pond-ts/pond/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pond-ts/pond.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs-fallback.cjs"
    },
    "./types": {
      "types": "./dist/schema/public.d.ts",
      "import": "./dist/schema/public.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "API.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"test-d/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"test-d/**/*.ts\"",
    "prepack": "cp ../../README.md ./README.md && cp ../../LICENSE ./LICENSE && cp ../../CHANGELOG.md ./CHANGELOG.md && cp ../../API.md ./API.md && cp ../../docs/agents/USING_POND.md ./AGENTS.md && npm run build && cp cjs-fallback.cjs dist/cjs-fallback.cjs && find dist -name '*.map' -delete",
    "test": "npm run test:type && npm run test:runtime",
    "test:runtime": "vitest run",
    "test:type": "tsc -p tsconfig.types.json",
    "verify": "npm run format:check && npm run build && npm test"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.2",
    "@types/node": "^20.17.0",
    "apache-arrow": "^21.2.0",
    "pondjs": "^0.9.0",
    "prettier": "^3.8.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  }
}
