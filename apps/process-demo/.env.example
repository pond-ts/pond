# The composer falls back to an offline keyword matcher without a key.
# Anthropic wins when both are set. An EMPTY value counts as absent, so
# leaving a placeholder blank below is safe.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides.
# PROCESS_DEMO_MODEL=claude-opus-5   # or gpt-5.4 on the OpenAI path
# PROCESS_DEMO_NO_FALLBACKS=1
# PORT=8787
# PROCESS_DEMO_NO_STRICT=1   # OpenAI path: send the tool schema non-strict
